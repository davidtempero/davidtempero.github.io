---
import { getCollection } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { areas, byOrder, entryUrl, formatDate, type Entry } from '../lib/content';
interface Props { entry: Entry; headings: MarkdownHeading[]; }
const { entry, headings } = Astro.props;
const area = entry.collection === 'knowledge' ? areas.find(area => area.id === entry.data.area)! : null;
const siblings: Entry[] = area ? (await getCollection('knowledge', item => item.data.area === area.id)).sort(byOrder) : (await getCollection('projects')).sort(byOrder);
const crumbs = area ? [{ label: 'Knowledge', href: '/knowledge/' }, { label: area.title, href: `/knowledge/${area.id}/` }, { label: entry.data.title }] : [{ label: 'Projects', href: '/projects/' }, { label: entry.data.title }];
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <Breadcrumbs items={crumbs} />
  <div class="article-grid"><aside class="article-sidebar"><details open><summary>{area?.title ?? 'Projects'} topics</summary><nav aria-label="Related topics"><a class="sidebar-overview" href={area ? `/knowledge/${area.id}/` : '/projects/'}>← Overview</a>{siblings.map(item => <a href={entryUrl(item)} aria-current={entryUrl(item) === entryUrl(entry) ? 'page' : undefined}>{item.data.title}</a>)}</nav></details></aside>
  <article><header class="article-header"><span class="eyebrow">{area?.title ?? 'THE WORKBENCH'}</span><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p><p class="article-date">Content updated <time datetime={entry.data.updated.toISOString()}>{formatDate(entry.data.updated)}</time></p></header>
    {toc.length > 0 && <details class="on-this-page" open><summary>On this page</summary><nav aria-label="On this page"><ul>{toc.map(heading => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav></details>}
    <div class="prose article-body"><slot /></div>
    <div class="article-bottom"><a class="text-link" href={area ? `/knowledge/${area.id}/` : '/projects/'}>← Back to {area?.title.toLowerCase() ?? 'projects'}</a></div>
  </article></div>
</BaseLayout>
<script>
  const narrow = window.matchMedia('(max-width: 760px)');
  const topics = document.querySelector<HTMLDetailsElement>('.article-sidebar details');
  const syncTopics = () => { if (topics) topics.open = !narrow.matches; };
  syncTopics();
  narrow.addEventListener('change', syncTopics);
</script>
