---
import BaseLayout from '../layouts/BaseLayout.astro';
import AreaCards from '../components/AreaCards.astro';
import EntryList from '../components/EntryList.astro';
import KeyboardDrawing from '../components/KeyboardDrawing.astro';
import { getCollection } from 'astro:content';
const entries = [...await getCollection('knowledge'), ...await getCollection('projects')].sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime() || a.data.title.localeCompare(b.data.title)).slice(0, 4);
---
<BaseLayout title="Home">
  <section class="hero">
    <div class="eyebrow"><span class="status-dot" aria-hidden="true"></span> A PERSONAL CORNER OF THE WEB</div>
    <h1>Curiosity.<br />Code.<br /><span>Things to build.</span></h1>
    <div class="hero-bottom"><p>I’m David. This is where I collect technical notes, useful resources, and ideas across programming, electronics, and the projects that connect them.</p><a class="text-link" href="/about/">A little about me <span aria-hidden="true">↗</span></a></div>
    <span class="hero-decoration" aria-hidden="true">{ '{' }<span>dt</span>{ '}' }</span>
  </section>
  <section class="section-block" aria-labelledby="explore-heading">
    <div class="section-heading"><div><span class="eyebrow">THE KNOWLEDGE LIBRARY</span><h2 id="explore-heading">Follow your curiosity.</h2></div><a class="text-link" href="/knowledge/">All topics <span aria-hidden="true">→</span></a></div>
    <AreaCards />
  </section>
  <section class="project-feature section-block" aria-labelledby="project-heading">
    <div><span class="eyebrow">ON THE WORKBENCH / 01</span><h2 id="project-heading">Small boards.<br />Many possibilities.</h2><p>An exploration of split keyboards. Designs, wireless controllers, firmware, and the parts that bring them together.</p><a class="button" href="/projects/split-keyboards/">Explore split keyboards <span aria-hidden="true">↗</span></a></div>
    <div class="project-art"><KeyboardDrawing /><span class="art-caption">SPLIT KEYBOARDS / DESIGN EXPLORATION</span></div>
  </section>
  <section class="section-block updates" aria-labelledby="updates-heading"><div class="section-heading"><div><span class="eyebrow">FROM THE NOTEBOOK</span><h2 id="updates-heading">Recently updated.</h2></div><span class="small-note">Dates reflect content edits.</span></div><EntryList entries={entries} dates /></section>
</BaseLayout>
