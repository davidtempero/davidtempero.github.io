---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
export async function getStaticPaths() { return (await getCollection('projects')).map(entry => ({ params: { project: entry.id }, props: { entry } })); }
interface Props { entry: CollectionEntry<'projects'>; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<ArticleLayout entry={entry} headings={headings}><Content /></ArticleLayout>
